@page "/signup"

<Toast @ref="toastComponent"/>
<LogoTitle Title="Sign Up"/>
<div class="sign-up-form">
    <input type="text" placeholder="Username" class="sign-up-input-field scale-on-interaction" @bind="username"/>
    <input type="email" placeholder="E-Mail" class="sign-up-input-field scale-on-interaction" @bind="email"/>
    <input type="password" placeholder="Password" class="sign-up-input-field scale-on-interaction" @bind="password"/>
    <input type="password" placeholder="Confirm Password" class="sign-up-input-field scale-on-interaction"
           @bind="confirmPassword"/>
    <MudButton Class="mud-auth-button scale-on-interaction" OnClick="HandleSignUp">
        Sign Up
    </MudButton>
</div>
<div class="sign-up-link-container">
    <p class="sign-up-question-text">Already have an account?</p>
    <a href="@AppRoutes.LoginUrl" class="sign-up-link scale-on-interaction">Sign In</a>
</div>

@code {
    private Toast toastComponent;
    private string username;
    private string email;
    private string password;
    private string confirmPassword;

    private async Task HandleSignUp()
    {
        try
        {
            var user = await UserService.SignUpUserAsync(username, email, password, confirmPassword);
            if (user != null)
            {
                toastComponent.Show("User signed up successfully!", "success");
                NavigationManager.NavigateTo(AppRoutes.LoginUrl);
            }
        }
        catch (Exception ex)
        {
            toastComponent.Show($"Sign Up failed: {ex.Message}", "error");
        }
    }

}