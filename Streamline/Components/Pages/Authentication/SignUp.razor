@page "/signup"

<LogoTitle Title="Sign Up" LogoWidth="150px" LogoHeight="150px"/>
<div class="sign-up-form">
    <input type="text" placeholder="Username" class="@String.GetSignUpInputFieldClass(_hasUsernameError)"
           @bind="_username" @bind:after="SaveDataToStorage"/>
    <input type="email" placeholder="E-Mail" class="@String.GetSignUpInputFieldClass(_hasEmailError)" @bind="_email"
           @bind:after="SaveDataToStorage"/>
    <input type="date" id="birthday" @bind="_birthday" @bind:after="SaveDataToStorage"
           class="@String.GetSignUpInputFieldClass(_hasBirthdayError)"/>
    <input type="password" placeholder="Password" class="@String.GetSignUpInputFieldClass(_hasPasswordError)"
           @bind="_password" @bind:after="SaveDataToStorage"/>
    <input type="password" placeholder="Confirm Password"
           class="@String.GetSignUpInputFieldClass(_hasConfirmPasswordError)"
           @bind="_confirmPassword" @bind:after="SaveDataToStorage"/>
    <div class="sign-up-terms-container">
        <input type="checkbox" id="termsCheckbox" class="scale-on-interaction" @bind="_acceptedTerms"
               @bind:after="SaveDataToStorage"/>
        <label for="termsCheckbox" class="sign-up-terms-label">
            I accept the <a href="@AppRoutes.TermsUrl">Terms and Conditions</a>
        </label>
    </div>
    <MudButton Class="@String.AuthButtonClass(_isLoading)" Disabled="@_isLoading" OnClick="HandleSignUp">
        Sign Up
    </MudButton>
</div>
<div class="sign-up-link-container">
    <p class="sign-up-question-text">Already have an account?</p>
    <a href="@AppRoutes.LogInUrl" class="sign-up-link scale-on-interaction"
       @onclick="StorageService.ClearSignUpDataAsync">
        Sign In
    </a>
</div>

@code {
    private string _username = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private DateTime? _birthday;
    private bool _isLoading;
    private bool _hasUsernameError;
    private bool _hasEmailError;
    private bool _hasBirthdayError;
    private bool _hasPasswordError;
    private bool _hasConfirmPasswordError;
    private bool _acceptedTerms;

    protected override async Task OnInitializedAsync()
    {
        var formData = await StorageService.RetrieveSignUpDataAsync();

        _username = formData.GetValueOrDefault("Username", string.Empty);
        _email = formData.GetValueOrDefault("Email", string.Empty);
        _birthday = DateTime.TryParse(formData.GetValueOrDefault("Birthday", string.Empty), out var date) ? date : null;
        _password = formData.GetValueOrDefault("Password", string.Empty);
        _confirmPassword = formData.GetValueOrDefault("ConfirmPassword", string.Empty);
        _acceptedTerms = bool.TryParse(formData.GetValueOrDefault("AcceptedTerms", "false"), out var terms) && terms;
    }

    private async Task SaveDataToStorage()
    {
        var formData = new Dictionary<string, string>
        {
            { "Username", _username },
            { "Email", _email },
            { "Birthday", _birthday?.ToString("dd-MM-yyyy") ?? string.Empty },
            { "Password", _password },
            { "ConfirmPassword", _confirmPassword },
            { "AcceptedTerms", _acceptedTerms.ToString() }
        };

        await StorageService.SaveSignUpDataAsync(formData);
    }

    private async Task HandleSignUp()
    {
        _isLoading = true;
        _hasUsernameError = false;
        _hasEmailError = false;
        _hasPasswordError = false;
        _hasConfirmPasswordError = false;
        _hasBirthdayError = false;

        if (string.IsNullOrWhiteSpace(_username) || !Validation.IsUsernameValid(_username))
        {
            ToastService.ShowToast("Invalid username. Must be 3-16 characters and can include letters, numbers, underscores, or hyphens", ToastStatus.Warning);
            _isLoading = false;
            _hasUsernameError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(_email) || !Validation.IsEmailValid(_email))
        {
            ToastService.ShowToast("Invalid Email Format. Please enter a valid email address", ToastStatus.Warning);
            _isLoading = false;
            _hasEmailError = true;
            return;
        }

        if (!_birthday.HasValue || _birthday.Value > DateTime.Today)
        {
            ToastService.ShowToast("Please enter a valid birthday", ToastStatus.Warning);
            _isLoading = false;
            _hasBirthdayError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(_password) || !Validation.IsPasswordValid(_password))
        {
            ToastService.ShowToast("Password must be 8-255 characters long and include at least one lowercase letter, one uppercase letter, one number, and one special character"
                , ToastStatus.Warning);
            _isLoading = false;
            _hasPasswordError = true;
            return;
        }

        if (!Validation.IsPasswordMatch(_password, _confirmPassword))
        {
            ToastService.ShowToast("Passwords do not match", ToastStatus.Warning);
            _isLoading = false;
            _hasConfirmPasswordError = true;
            return;
        }

        if (!_acceptedTerms)
        {
            ToastService.ShowToast("Please accept the terms and conditions", ToastStatus.Warning);
            _isLoading = false;
            return;
        }

        try
        {
            var user = await UserService.SignUpUserAsync(
                _username,
                _email,
                String.BackendBirthdayFormat(_birthday.Value),
                _password,
                _confirmPassword
            );

            if (user != null)
            {
                ToastService.ShowToast($"Account created for {_username}", ToastStatus.Success);
                NavigationManager.NavigateTo(AppRoutes.LogInUrl);
                StorageService.ClearSignUpDataAsync();
            }
        }
        catch (Exception ex)
        {
            if (ex.Message.StartsWith("UsernameError:"))
            {
                ToastService.ShowToast("Username is already taken", ToastStatus.Error);
                _hasUsernameError = true;
            }
            else if (ex.Message.StartsWith("EmailError:"))
            {
                ToastService.ShowToast("Email is already taken", ToastStatus.Error);
                _hasEmailError = true;
            }
            else
            {
                ToastService.ShowToast($"Sign Up failed: {ex.Message}", ToastStatus.Error);
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

}