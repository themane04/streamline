@page "/signup"

<div class="page-container vh-100 overflow-hidden">
    <div class="outer-container">
        <LogoTitle/>
        <div class="form">
            <input
                type="text"
                placeholder="Username"
                class="input-field scale-on-interaction"
            />
            <input
                type="email"
                placeholder="E-Mail"
                class="input-field scale-on-interaction"
            />
            <input
                type="password"
                placeholder="Password"
                class="input-field scale-on-interaction"
            />
            <input
                type="password"
                placeholder="Confirm Password"
                class="input-field scale-on-interaction"
            />
            <MudButton href="@AppRoutes.LoginUrl" class="mud-auth-button scale-on-interaction">Sign Up</MudButton>
        </div>
        <div class="link-container">
            <p class="question-text">Already have an account?</p>
            <a href="@AppRoutes.LoginUrl" class="link scale-on-interaction">Log In</a>
        </div>
    </div>
</div>