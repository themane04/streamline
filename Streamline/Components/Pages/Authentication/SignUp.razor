@page "/signup"

<LogoTitle Title="Sign Up"/>
<div class="sign-up-form">
    <input type="text" placeholder="Username" class="sign-up-input-field scale-on-interaction" @bind="_username"/>
    <input type="email" placeholder="E-Mail" class="sign-up-input-field scale-on-interaction" @bind="_email"/>
    <input type="password" placeholder="Password" class="sign-up-input-field scale-on-interaction" @bind="_password"/>
    <input type="password" placeholder="Confirm Password" class="sign-up-input-field scale-on-interaction"
           @bind="_confirmPassword"/>
    <MudButton Class="@SignUpButtonClass" Disabled="@_isLoading" OnClick="HandleSignUp">
        Sign Up
    </MudButton>
</div>
<div class="sign-up-link-container">
    <p class="sign-up-question-text">Already have an account?</p>
    <a href="@AppRoutes.LoginUrl" class="sign-up-link scale-on-interaction">Sign In</a>
</div>

@code {
    private string _username = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _isLoading;
    
    private string SignUpButtonClass =>
        "mud-auth-button scale-on-interaction" + (_isLoading ? " mud-auth-button-disabled" : "");

    private async Task HandleSignUp()
    {
        _isLoading = true;
        try
        {
            var user = await UserService.SignUpUserAsync(_username, _email, _password, _confirmPassword);
            if (user != null)
            {
                ToastService.ShowToast($"Account created for {_username}", ToastStatus.Success);
                NavigationManager.NavigateTo(AppRoutes.LoginUrl);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowToast($"Sign Up failed: {ex.Message}", ToastStatus.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

}