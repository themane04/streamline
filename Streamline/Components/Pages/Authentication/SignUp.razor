@page "/signup"

<div class="sign-up-page-container">
    <div class="sign-up-outer-container">
        <LogoTitle/>
        <div class="sign-up-form">
            <input type="text" placeholder="Username" class="sign-up-input-field scale-on-interaction"/>
            <input type="email" placeholder="E-Mail" class="sign-up-input-field scale-on-interaction"/>
            <input type="password" placeholder="Password" class="sign-up-input-field scale-on-interaction"/>
            <input type="password" placeholder="Confirm Password" class="sign-up-input-field scale-on-interaction"/>
            <MudButton href="@AppRoutes.LoginUrl" class="mud-auth-button scale-on-interaction">Sign Up</MudButton>
        </div>
        <div class="sign-up-link-container">
            <p class="sign-up-question-text">Already have an account?</p>
            <a href="@AppRoutes.LoginUrl" class="sign-up-link scale-on-interaction">Log In</a>
        </div>
    </div>
</div>