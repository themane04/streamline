@page "/signup"

<LogoTitle Title="Sign Up"/>
<div class="sign-up-form">
    <input type="text" placeholder="Username" class="@String.GetSignUpInputFieldClass(_hasUsernameError)"
           @bind="_username"/>
    <input type="email" placeholder="E-Mail" class="@String.GetSignUpInputFieldClass(_hasEmailError)" @bind="_email"/>
    <input type="password" placeholder="Password" class="@String.GetSignUpInputFieldClass(_hasPasswordError)"
           @bind="_password"/>
    <input type="password" placeholder="Confirm Password"
           class="@String.GetSignUpInputFieldClass(_hasConfirmPasswordError)"
           @bind="_confirmPassword"/>
    <MudButton Class="@String.AuthButtonClass(_isLoading)" Disabled="@_isLoading" OnClick="HandleSignUp">
        Sign Up
    </MudButton>
</div>
<div class="sign-up-link-container">
    <p class="sign-up-question-text">Already have an account?</p>
    <a href="@AppRoutes.LoginUrl" class="sign-up-link scale-on-interaction">Sign In</a>
</div>

@code {
    private string _username = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _isLoading;
    private bool _hasUsernameError;
    private bool _hasEmailError;
    private bool _hasPasswordError;
    private bool _hasConfirmPasswordError;

    private async Task HandleSignUp()
    {
        _isLoading = true;
        _hasUsernameError = false;
        _hasEmailError = false;
        _hasPasswordError = false;
        _hasConfirmPasswordError = false;

        if (string.IsNullOrWhiteSpace(_username) || !Validation.IsUsernameValid(_username))
        {
            ToastService.ShowToast("Invalid username. Must be 3-16 characters and can include letters, numbers, underscores, or hyphens", ToastStatus.Warning);
            _isLoading = false;
            _hasUsernameError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(_email) || !Validation.IsEmailValid(_email))
        {
            ToastService.ShowToast("Invalid Email Format. Please enter a valid email address", ToastStatus.Warning);
            _isLoading = false;
            _hasEmailError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(_password) || !Validation.IsPasswordValid(_password))
        {
            ToastService.ShowToast("Password must be 8-255 characters long and include at least one lowercase letter, one uppercase letter, one number, and one special character"
                , ToastStatus.Warning);
            _isLoading = false;
            _hasPasswordError = true;
            return;
        }

        if (!Validation.IsPasswordMatch(_password, _confirmPassword))
        {
            ToastService.ShowToast("Passwords do not match", ToastStatus.Warning);
            _isLoading = false;
            _hasConfirmPasswordError = true;
            return;
        }

        try
        {
            var user = await UserService.SignUpUserAsync(_username, _email, _password, _confirmPassword);

            if (user != null)
            {
                ToastService.ShowToast($"Account created for {_username}", ToastStatus.Success);
                NavigationManager.NavigateTo(AppRoutes.LoginUrl);
            }
        }
        catch (Exception ex)
        {
            if (ex.Message.StartsWith("UsernameError:"))
            {
                ToastService.ShowToast("Username is already taken", ToastStatus.Error);
                _hasUsernameError = true;
            }
            else if (ex.Message.StartsWith("EmailError:"))
            {
                ToastService.ShowToast("Email is already taken", ToastStatus.Error);
                _hasEmailError = true;
            }
            else
            {
                ToastService.ShowToast($"Sign Up failed: {ex.Message}", ToastStatus.Error);
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

}