@page "/"

@code
{
    
}

<div class="page-container vh-100 overflow-hidden">
    <div class="outer-container">
        <div>
            <img src="images/logo/streamline_transparent.png"
                 alt="Streamline Logo"
                 class="logo" />
            <p class="streamline-title">Streamline</p>
        </div>
        <div class="form">
            <input type="text"
                   placeholder="E-Mail"
                   class="input-field scale-on-interaction" />
            <input type="password"
                   placeholder="Password"
                   class="input-field scale-on-interaction" />
            <MudButton href="@AppRoutes.HomeUrl" class="mud-auth-button scale-on-interaction">Log In</MudButton>
        </div>
        <div class="link-container">
            <p class="question-text">Don’t have an account?</p>
            <a href="@AppRoutes.SignupUrl" class="link scale-on-interaction">Sign Up</a>
        </div>
    </div>
</div>