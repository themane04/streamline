@page "/"

<div>
    <img src="images/logo/streamline_transparent.png" alt="Streamline Logo" class="sign-in-logo"/>
    <p class="sign-in-streamline-title">Sign In</p>
</div>
<div class="sign-in-form">
    <input type="text" placeholder="E-Mail" class="@String.GetSignInInputFieldClass(_hasEmailError)"
           @bind="_email"/>
    <input type="password" placeholder="Password" class="@String.GetSignInInputFieldClass(_hasPasswordError)"
           @bind="_password"/>
    <MudButton Class="@String.AuthButtonClass(_isLoading)" Disabled="@_isLoading" OnClick="HandleSignIn">Sign In
    </MudButton>
</div>
<div class="sign-in-link-container">
    <p class="sign-in-question-text">Don’t have an account?</p>
    <a href="@AppRoutes.SignupUrl" class="sign-in-link scale-on-interaction">Sign Up</a>
</div>

@code {
    [Inject] private AuthService AuthService { get; set; } = default!;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _isLoading;
    private bool _hasEmailError;
    private bool _hasPasswordError;

    private async Task HandleSignIn()
    {
        _isLoading = true;
        _hasEmailError = false;
        _hasPasswordError = false;

        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            ToastService.ShowToast("Please fill in all fields", ToastStatus.Info);
            _isLoading = false;
            _hasEmailError = true;
            _hasPasswordError = true;
            return;
        }

        if (!Validation.IsEmailValid(_email))
        {
            ToastService.ShowToast("Please enter a valid email address", ToastStatus.Warning);
            _isLoading = false;
            _hasEmailError = true;
            return;
        }

        try
        {
            var signInResponse = await UserService.SignInUserAsync(_email, _password);
            if (signInResponse != null)
            {
                await AuthService.SetAuthState(signInResponse);
                ToastService.ShowToast($"Welcome Back {signInResponse.Data.User?.Username}", ToastStatus.Success);
                NavigationManager.NavigateTo(AppRoutes.HomeUrl, forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("No active account found with the given credentials"))
            {
                ToastService.ShowToast("No account found with the provided email and password. Please try again", ToastStatus.Error);
            }
            else
            {
                ToastService.ShowToast("Sign-in failed. Please try again later", ToastStatus.Error);
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

}
