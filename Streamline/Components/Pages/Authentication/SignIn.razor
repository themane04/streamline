@page "/"

<div class="sign-in-page-container">
    <div class="sign-in-outer-container">
        <div>
            <img src="images/logo/streamline_transparent.png" alt="Streamline Logo" class="sign-in-logo"/>
            <p class="sign-in-streamline-title">Sign In</p>
        </div>
        <div class="sign-in-form">
            <input type="text" placeholder="E-Mail" class="sign-in-input-field scale-on-interaction"/>
            <input type="password" placeholder="Password" class="sign-in-input-field scale-on-interaction"/>
            <MudButton Href="@AppRoutes.HomeUrl" Class="mud-auth-button scale-on-interaction">Sign In</MudButton>
        </div>
        <div class="sign-in-link-container">
            <p class="sign-in-question-text">Don’t have an account?</p>
            <a href="@AppRoutes.SignupUrl" class="sign-in-link scale-on-interaction">Sign Up</a>
        </div>
    </div>
</div>