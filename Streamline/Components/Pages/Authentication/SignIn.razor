@page "/"

<div>
    <img src="images/logo/streamline_transparent.png" alt="Streamline Logo" class="sign-in-logo"/>
    <p class="sign-in-streamline-title">Sign In</p>
</div>
<div class="sign-in-form">
    <input type="text" placeholder="E-Mail" class="sign-in-input-field scale-on-interaction" @bind="_email"/>
    <input type="password" placeholder="Password" class="sign-in-input-field scale-on-interaction" @bind="_password"/>
    <MudButton Class="mud-auth-button scale-on-interaction" OnClick="HandleSignIn">Sign In</MudButton>
</div>
<div class="sign-in-link-container">
    <p class="sign-in-question-text">Don’t have an account?</p>
    <a href="@AppRoutes.SignupUrl" class="sign-in-link scale-on-interaction">Sign Up</a>
</div>

@code {
    private string _email = string.Empty;
    private string _password = string.Empty;

    private async Task HandleSignIn()
    {
        try
        {
            var signInResponse = await UserService.SignInUserAsync(_email, _password);
            if (signInResponse != null)
            {
                ToastService.ShowToast($"Welcome Back {signInResponse.User.Username}", ToastStatus.Success);
                NavigationManager.NavigateTo(AppRoutes.HomeUrl);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowToast($"Sign In failed: {ex.Message}", ToastStatus.Error);
        }
    }

}
