@page "/"

<Toast @ref="toastComponent"/>
<div>
    <img src="images/logo/streamline_transparent.png" alt="Streamline Logo" class="sign-in-logo"/>
    <p class="sign-in-streamline-title">Sign In</p>
</div>
<div class="sign-in-form">
    <input type="text" placeholder="E-Mail" class="sign-in-input-field scale-on-interaction" @bind="email"/>
    <input type="password" placeholder="Password" class="sign-in-input-field scale-on-interaction" @bind="password"/>
    <MudButton Class="mud-auth-button scale-on-interaction" OnClick="HandleSignIn">Sign In</MudButton>
</div>
<div class="sign-in-link-container">
    <p class="sign-in-question-text">Don’t have an account?</p>
    <a href="@AppRoutes.SignupUrl" class="sign-in-link scale-on-interaction">Sign Up</a>
</div>

@code {
    private Toast toastComponent;
    private string email;
    private string password;

    private async Task HandleSignIn()
    {
        try
        {
            var signInResponse = await UserService.SignInUserAsync(email, password);
            Console.WriteLine("Sign-in attempt completed.");
            if (signInResponse != null)
            {
                Console.WriteLine("Sign-in response is not null.");
                toastComponent.Show("User signed in successfully!", "success");
                Console.WriteLine("Navigating to home page.");
                NavigationManager.NavigateTo(AppRoutes.HomeUrl);
                Console.WriteLine("Navigation called.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception occurred: " + ex);
            toastComponent.Show($"Sign In failed: {ex.Message}", "error");
        }
    }

}
