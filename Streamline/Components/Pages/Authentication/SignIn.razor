@page "/"

<div class="page-container" style="overflow: hidden">
    <div class="outer-container">
        <div>
            <img src="images/logo/streamline_transparent.png"
                 alt="Streamline Logo"
                 class="logo" />
            <p class="streamline-title">Streamline</p>
        </div>
        <div class="form">
            <input type="text"
                   placeholder="E-Mail"
                   class="input-field scale-on-interaction" />
            <input type="password"
                   placeholder="Password"
                   class="input-field scale-on-interaction" />
            <a href="/home" class="button scale-on-interaction">Log In</a>
        </div>
        <div class="link-container">
            <p class="question-text">Don’t have an account?</p>
            <a href="/signup" class="link scale-on-interaction">Sign Up</a>
        </div>
    </div>
</div>