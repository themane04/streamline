@using System.Text
@using Microsoft.AspNetCore.Components.Forms

@page "/profile"

<Modal
    Title="Change Profile Picture"
    Description="Upload a new profile picture"
    IsVisible="_isImageModalVisible"
    Width="400px"
    CloseOnOverlayClick="true"
    OnClose="CloseImageModal"
    ProfileImageIcon="true"
    ButtonText="Upload Image"
    OnButtonClick="TriggerFileUpload"
>
    <div style="display:none">
        <InputFile OnChange="HandleFileSelected" id="fileInput"/>
    </div>
</Modal>
<Modal
    Title="Change Password"
    Description="Change your password"
    IsVisible="_isPasswordModalVisible"
    Width="400px"
    CloseOnOverlayClick="true"
    OnClose="ClosePasswordModal"
    PasswordResetIcon="true"
    ButtonText="Change Password"
    OnButtonClick="UpdatePassword"
>
    <input type="password" class="@String.GetProfilePasswordResetInputFieldClass(_oldPasswordHasError)"
           @bind-value="_oldPassword" @bind-value:event="oninput" placeholder="Old Password"/>
    <input type="password" class="@String.GetProfilePasswordResetInputFieldClass(_newPasswordHasError)"
           @bind-value="_newPassword" @bind-value:event="oninput" placeholder="New Password"/>
    <input type="password" class="@String.GetProfilePasswordResetInputFieldClass(_confirmNewPasswordHasError)"
           @bind-value="_confirmNewPassword" @bind-value:event="oninput" placeholder="Confirm New Password"/>
</Modal>
<LogoTitle Title="Profile"/>
<div>
    @if (AuthService.User != null)
    {
        <div @onclick="OpenImageModal">
            <img src="@AuthService.User.ProfileImage" alt="@AuthService.User.Username's Profile Picture"
                 class="profile-page-profile-picture scale-on-interaction"/>
        </div>
        <div class="profile-page-form">
            <input type="text" class="profile-page-input-field scale-on-interaction"
                   @bind-value="_editedUsername" @bind-value:event="oninput"/>
            <input type="text" class="profile-page-input-field scale-on-interaction"
                   @bind-value="_editedEmail" @bind-value:event="oninput"/>
        </div>
        <div class="profile-page-button-container">
            <MudButton Class="@SaveButtonClass" Disabled="@IsSaveDisabled" OnClick="SaveData">
                <MudIcon Icon="@Icons.Material.Filled.Save" Style="@SaveIconStyle"/>
                Save Data
            </MudButton>
            <MudButton Class="mud-auth-button mud-movie-detail-button scale-on-interaction" OnClick="OpenPasswordModal">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Style="width: 20px;height: 20px;"/>
                Password
            </MudButton>
        </div>
    }
    else
    {
        <LoadingSpinner/>
    }
</div>

@code {
    [Inject] private AuthService AuthService { get; set; } = default!;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Profile>? _dotNetRef;
    private bool _isImageModalVisible;
    private bool _isPasswordModalVisible;
    private string _editedUsername = string.Empty;
    private string _editedEmail = string.Empty;
    private string _oldPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmNewPassword = string.Empty;
    private bool _oldPasswordHasError;
    private bool _newPasswordHasError;
    private bool _confirmNewPasswordHasError;

    private string SaveButtonClass =>
        "mud-auth-button mud-movie-detail-button scale-on-interaction" + (IsSaveDisabled ? " mud-auth-button-disabled" : "");

    private string SaveIconStyle => $"width: 20px; height: 20px; fill: {(IsSaveDisabled ? "var(--grayed-out-color)" : "var(--text-color)")};";


    private bool IsSaveDisabled =>
        AuthService.User != null &&
        _editedUsername == AuthService.User.Username &&
        _editedEmail == AuthService.User.Email;

    private void OpenImageModal()
    {
        _isImageModalVisible = true;
    }

    private void CloseImageModal()
    {
        _isImageModalVisible = false;
    }

    private void OpenPasswordModal()
    {
        _isPasswordModalVisible = true;
    }

    private void ClosePasswordModal()
    {
        _isPasswordModalVisible = false;
    }

    private void ClearPasswordFields()
    {
        _oldPassword = string.Empty;
        _newPassword = string.Empty;
        _confirmNewPassword = string.Empty;
    }

    protected override void OnInitialized()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        if (AuthService.User != null)
        {
            _editedUsername = AuthService.User.Username;
            _editedEmail = AuthService.User.Email;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/global.js");
        }
    }

    private async Task TriggerFileUpload()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("triggerFileUpload", "fileInput");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        Console.WriteLine($"Selected file: {file.Name}, Size: {file.Size} bytes");

        if (file.Size > 5 * 1024 * 1024)
        {
            ToastService.ShowToast("File size exceeds 5 MB", ToastStatus.Warning);
            return;
        }

        try
        {
            if (AuthService.User != null)
            {
                Console.WriteLine("Calling UpdateProfilePictureAsync...");
                var response = await UserService.UpdateProfilePictureAsync(AuthService.User.Id, file);

                if (response?.Data != null)
                {
                    AuthService.User.ProfileImage = response.Data.ProfileImage;
                    ToastService.ShowToast("Profile picture updated successfully", ToastStatus.Success);
                    _isImageModalVisible = false;
                }
                else
                {
                    ToastService.ShowToast("Failed to update profile picture", ToastStatus.Error);
                }
            }
        }
        catch (Exception ex)
        {
            var detailedMessage = new StringBuilder();
            detailedMessage.AppendLine($"Exception: {ex.Message}");
            detailedMessage.AppendLine($"Stack Trace: {ex.StackTrace}");

            if (ex.InnerException != null)
            {
                detailedMessage.AppendLine($"Inner Exception: {ex.InnerException.Message}");
                detailedMessage.AppendLine($"Inner Stack Trace: {ex.InnerException.StackTrace}");
            }

            Console.WriteLine(detailedMessage.ToString());

            ToastService.ShowToast(
                $"Failed to upload image. Error: {ex.Message}. Check logs for details.",
                ToastStatus.Error
            );
        }
    }

    private async Task SaveData()
    {
        if (AuthService.User != null)
        {
            if (string.IsNullOrWhiteSpace(_editedUsername) || string.IsNullOrWhiteSpace(_editedEmail))
            {
                ToastService.ShowToast("Username or email cannot be empty", ToastStatus.Warning);
                _editedUsername = AuthService.User.Username;
                _editedEmail = AuthService.User.Email;
                return;
            }

            if (!Validation.IsUsernameValid(_editedUsername))
            {
                ToastService.ShowToast("Invalid username. Must be 3-16 characters and can include letters, numbers, underscores, or hyphens", ToastStatus.Warning);
                return;
            }

            if (!Validation.IsEmailValid(_editedEmail))
            {
                ToastService.ShowToast("Invalid Email Format. Please enter a valid email address", ToastStatus.Warning);
                return;
            }

            try
            {
                await UserService.UpdateProfileAsync(AuthService.User.Id, _editedUsername, _editedEmail);
                AuthService.User.Username = _editedUsername;
                AuthService.User.Email = _editedEmail;
                ToastService.ShowToast("Profile updated successfully", ToastStatus.Success);
            }
            catch (Exception e)
            {
                Console.WriteLine(e.Message);
                ToastService.ShowToast(e.Message, ToastStatus.Error);
                throw;
            }
        }
    }

    private async Task UpdatePassword()
    {
        if (AuthService.User != null)
        {
            _oldPasswordHasError = false;
            _newPasswordHasError = false;
            _confirmNewPasswordHasError = false;

            if (string.IsNullOrWhiteSpace(_oldPassword) || string.IsNullOrWhiteSpace(_newPassword) || string.IsNullOrWhiteSpace(_confirmNewPassword))
            {
                ToastService.ShowToast("All fields are required", ToastStatus.Info);
                _oldPasswordHasError = true;
                _newPasswordHasError = true;
                _confirmNewPasswordHasError = true;
                return;
            }

            if (!Validation.IsPasswordValid(_newPassword))
            {
                ToastService.ShowToast("Password must be 8-255 characters long and include at least one lowercase letter, one uppercase letter, one number, and one special character", ToastStatus.Warning);
                _newPasswordHasError = true;
                return;
            }

            if (!Validation.IsPasswordMatch(_newPassword, _confirmNewPassword))
            {
                ToastService.ShowToast("Passwords do not match", ToastStatus.Warning);
                _confirmNewPasswordHasError = true;
                return;
            }

            try
            {
                await UserService.ResetPasswordAsync(AuthService.User.Id, _oldPassword, _newPassword, _confirmNewPassword);
                ToastService.ShowToast("Password updated successfully", ToastStatus.Success);
                _isPasswordModalVisible = false;
                ClearPasswordFields();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Caught exception: {ex.Message}");

                if (ex.Message.Contains("PasswordError: Incorrect password", StringComparison.OrdinalIgnoreCase))
                {
                    ToastService.ShowToast("Old password is incorrect", ToastStatus.Error);
                    _oldPasswordHasError = true;
                }
                else if (ex.Message.Contains("PasswordError:", StringComparison.OrdinalIgnoreCase))
                {
                    ToastService.ShowToast(ex.Message.Replace("PasswordError: ", ""), ToastStatus.Error);
                }
                else
                {
                    ToastService.ShowToast($"Password update failed: {ex.Message}", ToastStatus.Error);
                }
            }
        }
    }

}
