@page "/home"


@code {

    private IJSObjectReference? _module;
    private List<Movie> _movies = new();
    private int _currentPage = 1;
    private bool _isLoading;
    private DotNetObjectReference<Homepage>? _dotNetRef;
    private bool _isSearchActive;
    private string _searchQuery = "";

    private string ButtonClass => _isSearchActive
        ? "mud-search-button-container-hp expanded"
        : "mud-search-button-container-hp scale-on-interaction";

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        _movies = await MovieService.GetPopularMoviesAsync(_currentPage);
    }

    [JSInvokable]
    public async Task LoadNextPage()
    {
        if (_isLoading) return;

        _isLoading = true;
        try
        {
            _currentPage++;
            var newMovies = await MovieService.GetPopularMoviesAsync(_currentPage);

            if (newMovies.Count > 0)
            {
                _movies.AddRange(newMovies);
                StateHasChanged();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleSearch()
    {
        _isSearchActive = true;
        if (!_isSearchActive)
        {
            OnSearchInput(new ChangeEventArgs { Value = "" });
        }
    }

    private async void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _currentPage = 1;
            _movies = await MovieService.GetPopularMoviesAsync(_currentPage);
        }
        else
        {
            _movies = await MovieService.SearchMoviesAsync(_searchQuery);
        }

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/global.js");

            if (_module is not null)
            {
                await _module.InvokeVoidAsync("onScrollBottom", _dotNetRef);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }

        _dotNetRef?.Dispose();
    }

    private void NavigateToMovie(int movieId)
    {
        NavigationManager?.NavigateTo(AppRoutes.MovieDetailView + $"/{movieId}");
    }

}


<div class="page-container">
    <div class="outer-container">
        <div>
            <LogoTitle/>
            <div class="button-container">
                <MudButton OnClick="ToggleSearch"
                           class="@ButtonClass">
                    <div class="search-content">
                        <img
                            src="images/assets/homepage/search_icon_button.png"
                            alt="Search"
                            class="search-icon"
                            style="@(_isSearchActive ? "margin-left: 15px; margin-right: 15px;" : "margin-left: 0; margin-right: 0;")"
                        />
                        <input
                            @onclick:stopPropagation
                            @oninput="OnSearchInput"
                            type="text"
                            placeholder="Search for movies"
                            class="search-input"
                            style="@(_isSearchActive ? "display: block; opacity: 1; width: 100%;" : "display: none;")"
                        />
                    </div>
                </MudButton>
            </div>
        </div>
        <div class="movies-grid">
            <MovieItem Movies="_movies" OnMovieSelected="NavigateToMovie"/>
        </div>
        @if (_isLoading)
        {
            <LoadingSpinner/>
        }
    </div>
</div>