@page "/home"


<div class="page-container">
    <div class="outer-container">
        <div>
            <LogoTitle/>
            <div class="button-container">
                <button class="img-container scale-on-interaction">
                    <img src="images/assets/search_icon_button.png" alt="Search" class="search-icon"/>
                </button>
            </div>
        </div>
        <MovieGrid Movies="_movies"/>
        @if (_isLoading)
        {
            <LoadingSpinner/>
        }
    </div>
</div>

@code {
    private IJSObjectReference? _module;
    private List<Movie> _movies = new();
    private int _currentPage = 1;
    private bool _isLoading;
    private DotNetObjectReference<Homepage>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        _movies = await MovieService.GetPopularMoviesAsync(_currentPage);
    }

    [JSInvokable]
    public async Task LoadNextPage()
    {
        if (_isLoading) return;

        _isLoading = true;
        try
        {
            _currentPage++;
            var newMovies = await MovieService.GetPopularMoviesAsync(_currentPage);

            if (newMovies.Count > 0)
            {
                _movies.AddRange(newMovies);
                StateHasChanged();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/global.js");

            if (_module is not null)
            {
                await _module.InvokeVoidAsync("onScrollBottom", _dotNetRef);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }

        _dotNetRef?.Dispose();
    }

}
