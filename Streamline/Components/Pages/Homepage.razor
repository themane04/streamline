@page "/home"

<div>
    <LogoTitle Title="Showcase"/>
    <div class="homepage-button-container">
        <MudButton OnClick="ToggleSearch" class="@String.SearchButtonClass(_isSearchActive)">
            <div class="homepage-search-content">
                <img
                    src="images/assets/homepage/search_icon_button.png"
                    alt="Search"
                    class="homepage-search-icon"
                    style="@(_isSearchActive ? "margin-left: 15px; margin-right: 15px;" : "margin-left: 0; margin-right: 0;")"
                />
                <input
                    @onclick:stopPropagation
                    @oninput="OnSearchInput"
                    type="text"
                    placeholder="Search for movies"
                    class="homepage-search-input"
                    style="@(_isSearchActive ? "display: block; opacity: 1; width: 100%;" : "display: none;")"
                />
            </div>
        </MudButton>
    </div>
    <div class="homepage-button-container mt-3">
        <div class="homepage-genre-dropdown-container scale-on-interaction">
            <select id="genreDropdown" @onchange="OnGenreSelected" class="homepage-genre-dropdown">
                <option value="" disabled selected>Select a Genre</option>
                <option value="">All</option>
                @foreach (var genre in _genres)
                {
                    <option value="@genre.Id">@genre.Name</option>
                }
            </select>
        </div>
    </div>
</div>
<div class="homepage-movies-grid">
    @if (_isInitialLoading)
    {
        <LoadingSpinner/>
    }
    else if (_movies is not null && !_movies.Any())
    {
        <NoItemFound ImagePath="images/assets/homepage/no-play.png" Text="No movies found"/>
    }
    else
    {
        <MovieItem
            Movies="_movies"
            OnMovieSelected="@(id => NavigationManager.NavigateTo($"{AppRoutes.MovieDetailView}/{id}"))"
            PosterWidth="175px"
            PosterHeight="244px"
        />
    }
</div>

@if (_isPageLoading)
{
    <LoadingSpinner/>
}

@code {

    private IJSObjectReference? _module;
    private List<Movie>? _movies = new();
    private List<MovieGenre> _genres = new();
    private int _currentPage = 1;
    private bool _isInitialLoading;
    private bool _isPageLoading;
    private DotNetObjectReference<Homepage>? _dotNetRef;
    private bool _isSearchActive;
    private string _searchQuery = "";
    private int _selectedGenreId;

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        _genres = await MovieService.GetMovieGenresAsync();
    }

    private async Task OnGenreSelected(ChangeEventArgs e)
    {
        var selectedValue = e.Value?.ToString();

        _isInitialLoading = true;
        try
        {
            if (string.IsNullOrEmpty(selectedValue))
            {
                _movies = await MovieService.GetPopularMoviesAsync(_currentPage = 1);
            }
            else if (int.TryParse(selectedValue, out var genreId))
            {
                _selectedGenreId = genreId;
                _movies = await MovieService.GetMoviesByGenreAsync(genreId);
            }

            HomepageService.Movies = _movies;
            HomepageService.CurrentPage = 1;
        }
        finally
        {
            _isInitialLoading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (HomepageService.Movies != null && HomepageService.Movies.Any())
        {
            _movies = HomepageService.Movies;
            _currentPage = HomepageService.CurrentPage;
            return;
        }

        _isInitialLoading = true;
        _currentPage = 1;
        try
        {
            _movies = await MovieService.GetPopularMoviesAsync(_currentPage);
            HomepageService.Movies = _movies;
            HomepageService.CurrentPage = _currentPage;
        }
        finally
        {
            _isInitialLoading = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task LoadNextPage()
    {
        if (_isPageLoading) return;

        _isPageLoading = true;
        try
        {
            _currentPage++;
            var newMovies = await MovieService.GetPopularMoviesAsync(_currentPage);

            if (newMovies.Count > 0)
            {
                _movies?.AddRange(newMovies);
                HomepageService.Movies = _movies;
                HomepageService.CurrentPage = _currentPage;
                StateHasChanged();
            }
        }
        finally
        {
            _isPageLoading = false;
        }
    }

    private void ToggleSearch()
    {
        _isSearchActive = true;
        if (!_isSearchActive)
        {
            OnSearchInput(new ChangeEventArgs { Value = "" });
        }
    }

    private async void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";

        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _currentPage = 1;
            _movies = await MovieService.GetPopularMoviesAsync(_currentPage);
        }
        else
        {
            _movies = await MovieService.SearchMoviesAsync(_searchQuery);
        }

        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/global.js");

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("initializeScrollListener", _dotNetRef);
        }
    }


    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("cleanupScrollListener");
            await _module.DisposeAsync();
        }

        _dotNetRef?.Dispose();
    }

}