@page "/movie/{id:int}"

@if (Movie is not null)
{
    <div class="movie-detail-page-container">
        <BackArrowButton BackUrl="@AppRoutes.HomeUrl"/>
        @if (String.ImageStringAvailable(Movie.FullPosterPath))
        {
            <img src="@Movie.FullBackdropPath" alt="@Movie.Title" class="movie-detail-backdrop-image"/>
        }
        else
        {
            <img src="images/assets/movie-item/no-image-placeholder.png" alt="No image for @Movie?.Title"
                 class="movie-detail-backdrop-image movie-detail-backdrop-placeholder-image"/>
        }
        <div class="movie-detail-inner-container">
            <MovieItem
                SingleMovie="Movie"
                PosterHeight="195px"
                PosterWidth="138px"
                PosterMt="-100px"
                PosterMl="30px"
                ShowRating="false"
            />
            <MovieRating
                VoteAverage="@Movie?.VoteAverage.ToString("0.0")"
                VoteMt="180px"
                VoteMl="40%"/>
            <div class="movie-detail-content">
                <p class="movie-detail-movie-title">
                    @String.Truncate(Movie.Title, 16)
                </p>
                <div class="movie-detail-genre-container">
                    @foreach (var genre in Movie.Genres)
                    {
                        <div class="movie-detail-genre-inner-container">
                            <p class="movie-detail-genre-name">
                                @genre.Name
                            </p>
                        </div>
                    }
                </div>
                <div class="movie-detail-release-date-container">
                    <p class="movie-detail-release-date-text">Release Date:</p>
                    <p>@(DateTime.Parse(Movie.ReleaseDate).ToString("dd.MM.yyyy"))</p>
                </div>
            </div>
        </div>
        <div class="movie-detail-button-container">
            <MudButton
                Class="@WatchlistButtonClass"
                Disabled="@_isMovieInWatchlist"
                OnClick="@(_isMovieInWatchlist ? EventCallback.Empty : new EventCallback(this, AddMovieToWatchlist))"
            >
                <span>Add to Watchlist</span>
            </MudButton>
            <MudButton
                Class="@FavoritesButtonClass"
                Disabled="@_isMovieInFavorites"
                OnClick="@(_isMovieInFavorites ? EventCallback.Empty : new EventCallback(this, AddMovieToFavorites))"
                >
                Add To Favorites
            </MudButton>
        </div>
        <MovieDetailInformation
            MovieTagline="@Movie.Tagline"
            MovieBelongsToCollection="@Movie.BelongsToCollection"
            MovieProductionCompanies="@Movie.ProductionCompanies"
            MovieBudget="@Movie.Budget"
            MovieRevenue="@Movie.Revenue"
            MovieRuntime="@Movie.Runtime"
            MovieOverview="@Movie.Overview"
            MoviePopularity="@Movie.Popularity"
            SimilarMovies="@SimilarMovies"/>
    </div>
}
else
{
    <LoadingSpinner IsCentered="true"/>
}

@code {
    [Parameter] public int Id { get; set; }
    private MovieDetail? Movie { get; set; }
    private List<MovieDetail> SimilarMovies { get; set; } = new();
    private MovieShort ShortMovie { get; } = new();
    private bool _isMovieInWatchlist;
    private bool _isMovieInFavorites;

    private string WatchlistButtonClass =>
        "mud-auth-button mud-movie-detail-button scale-on-interaction"
        + (_isMovieInWatchlist ? " mud-auth-button-disabled" : "");
    
    private string FavoritesButtonClass =>
        "mud-auth-button mud-movie-detail-button scale-on-interaction"
        + (_isMovieInFavorites ? " mud-auth-button-disabled" : "");

    protected override async Task OnParametersSetAsync()
    {
        Movie = await MovieService.GetMovieDetailByIdAsync(Id);
        SimilarMovies = await MovieService.GetSimilarMoviesAsync(Id);
        _isMovieInWatchlist = await MovieService.IsMovieInWatchlist(Id);
        _isMovieInFavorites = await MovieService.IsMovieInFavorites(Id);
    }

    private async Task AddMovieToWatchlist()
    {
        if (Movie != null && !_isMovieInWatchlist)
        {
            ShortMovie.MovieId = Movie.Id;
            ShortMovie.Title = Movie.Title;
            ShortMovie.PosterPath = Movie.PosterPath ?? string.Empty;
            ShortMovie.VoteAverage = Movie.VoteAverage;
            await MovieService.AddOrUpdateMovieAndAddToWatchlist(ShortMovie);
            _isMovieInWatchlist = true;
            StateHasChanged();
        }
    }
    
    private async Task AddMovieToFavorites()
    {
        if (Movie != null && !_isMovieInFavorites)
        {
            ShortMovie.MovieId = Movie.Id;
            ShortMovie.Title = Movie.Title;
            ShortMovie.PosterPath = Movie.PosterPath ?? string.Empty;
            ShortMovie.VoteAverage = Movie.VoteAverage;
            await MovieService.AddOrUpdateMovieAndMarkAsFavorite(ShortMovie);
            _isMovieInFavorites = true;
            StateHasChanged();
        }
    }

}
