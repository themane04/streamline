@page "/watchlist"

<div>
    <LogoTitle Title="Watchlist"/>
</div>
<div class="watchlist-movies-grid">
    @if (_isLoading)
    {
        <LoadingSpinner/>
    }
    else
    {
        @if (_watchlistMovies == null || _watchlistMovies.Count == 0)
        {
            <NoItemFound
                ImagePath="images/assets/watchlist/broken-heart.png"
                Text="You have no movies in your watchlist yet."
            />
        }
        else
        {
            <MovieItem
                ShortMovie="@_watchlistMovies"
                OnMovieSelected="@(id => NavigationManager.NavigateTo($"/movie/{id}"))"
                PosterHeight="244px"
                PosterWidth="175px"
                ShowCloseButton="true"
                OnCloseIconClick="RemoveMovieFromWatchlist"
            />
        }
    }
</div>

@code {
    private List<MovieShort>? _watchlistMovies;
    private bool _isLoading;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            _watchlistMovies = await MovieService.GetWatchlist();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task RemoveMovieFromWatchlist(int movieId)
    {
        await MovieService.RemoveFromWatchlist(movieId);
        if (_watchlistMovies != null)
        {
            var movieToRemove = _watchlistMovies.FirstOrDefault(m => m.MovieId == movieId);
            if (movieToRemove != null)
            {
                _watchlistMovies.Remove(movieToRemove);
                StateHasChanged();
            }
        }
    }

}