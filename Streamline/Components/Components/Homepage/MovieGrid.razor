@code {
    [Parameter] public List<Movie>? Movies { get; set; }

    private void NavigateToMovie(int movieId)
    {
        NavigationManager?.NavigateTo(AppRoutes.MovieDetailView + $"/{movieId}");
    }

}

@if (Movies is not null && Movies.Any())
{
    <div class="movies-grid">
        @foreach (var movie in Movies)
        {
            <div class="movie-item scale-on-interaction" @onclick="() => NavigateToMovie(movie.Id)">
                <div class="poster-container">
                    <img src="@movie.FullPosterPath" alt="@movie.Title" class="movie-poster"/>
                    <div class="rating-container">
                        <img src="images/assets/homepage/rating_star.png" alt="Rating Star" class="rating-star"/>
                        <p class="movie-vote">@movie.VoteAverage.ToString("0.0")</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (Movies is not null && !Movies.Any())
{
    <div class="no-movies-container">
        <img
            src="images/assets/homepage/no-play.png"
            alt="No Movies Found"
            class="no-movies-image"
        />
        <p class="no-movies-text">No movies found</p>
    </div>
}
else
{
    <LoadingSpinner/>
}

