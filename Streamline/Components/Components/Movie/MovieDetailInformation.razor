<div class="movie-detail-information-text-content-container">
    @if (!string.IsNullOrWhiteSpace(MovieTagline))
    {
        <div class="movie-detail-information-text-details-container movie-detail-information-tagline-container">
            <p class="movie-detail-information-tagline">
                <q>@MovieTagline</q>
            </p>
        </div>
    }
    <div class="movie-detail-information-text-details-container">
        @if (String.ImageStringAvailable(MovieBelongsToCollection?.FullPosterPath))
        {
            <img src="@MovieBelongsToCollection?.FullPosterPath" alt="@MovieBelongsToCollection?.Name"
                 class="movie-detail-information-collection-image scale-on-interaction"/>
        }
        else if (!string.IsNullOrWhiteSpace(MovieBelongsToCollection?.Name))
        {
            <p>@MovieBelongsToCollection?.Name</p>
        }
        else
        {
            <p>No Collection</p>
        }
    </div>
    <div class="movie-detail-information-text-details-container">
        <div class="d-flex align-items-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Business" Class="mud-movie-detail-information-component-icon"/>
            <p class="movie-detail-information-header-text">Production Companies</p>
        </div>
        @if (MovieProductionCompanies?.Count > 0)
        {
            <p class="movie-detail-information-company-inner-container">
                @string.Join(", ", MovieProductionCompanies.Select(company => company.Name))
            </p>
        }
        else
        {
            <p>No Production Companies</p>
        }
    </div>
    <div class="movie-detail-information-text-details-container">
        <div class="d-flex align-items-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Class="mud-movie-detail-information-component-icon"/>
            <p class="movie-detail-information-header-text">Budget</p>
        </div>
        <p>@(MovieBudget > 0 ? MovieBudget.ToString("C0", new CultureInfo("en-US")) : "Not Available")</p>
    </div>
    <div class="movie-detail-information-text-details-container">
        <div class="d-flex align-items-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.MoneyOff" Class="mud-movie-detail-information-component-icon"/>
            <p class="movie-detail-information-header-text">Revenue</p>
        </div>
        <p>@(MovieRevenue > 0 ? MovieRevenue.ToString("C0", new CultureInfo("en-US")) : "Not Available")</p>
    </div>
    <div class="movie-detail-information-text-details-container">
        <div class="d-flex align-items-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="mud-movie-detail-information-component-icon"/>
            <p class="movie-detail-information-header-text">Runtime</p>
        </div>
        <p>@(MovieRuntime > 0 ? $"{MovieRuntime} minutes" : "Not Available")</p>
    </div>
    <div class="movie-detail-information-text-details-container">
        <div class="d-flex align-items-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Description" Class="mud-movie-detail-information-component-icon"/>
            <p class="movie-detail-information-header-text">Overview</p>
        </div>
        <p class="movie-detail-information-text-justify">@(string.IsNullOrWhiteSpace(MovieOverview) ? "No Overview" : MovieOverview)</p>
    </div>
    <div class="movie-detail-information-text-details-container movie-detail-information-popularity-container">
        <div class="d-flex align-items-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Star" Class="mud-movie-detail-information-component-icon"/>
            <p class="movie-detail-information-header-text">Popularity</p>
        </div>
        @if (MoviePopularity != 0)
        {
            <MoviePopularityChart MoviePopularity="MoviePopularity"/>
        }
        else
        {
            <p>No Popularity</p>
        }
    </div>
    <div class="movie-detail-information-text-details-container">
        <div class="d-flex align-items-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Movie" Class="mud-movie-detail-information-component-icon"/>
            <p class="movie-detail-information-header-text">More Like This</p>
        </div>
        @if (SimilarMovies.Count > 0)
        {
            <div class="movie-detail-information-similar-movies-container">
                @foreach (var similarMovie in SimilarMovies)
                {
                    <MovieItem
                        SingleMovie="similarMovie"
                        PosterHeight="195px"
                        PosterWidth="138px"
                        PosterMt="-100px"
                        RatingVoteMt="-100px"
                        OnMovieSelected="@(id => NavigationManager.NavigateTo($"{AppRoutes.MovieDetailView}/{id}", forceLoad: true))"
                    />
                }
            </div>
        }
        else
        {
            <p>No Similar Movies</p>
        }
    </div>
</div>

@code {
    [Parameter] public string MovieTagline { get; set; } = "";
    [Parameter] public MovieCollection? MovieBelongsToCollection { get; set; }
    [Parameter] public List<MovieProductionCompany>? MovieProductionCompanies { get; set; }
    [Parameter] public long MovieBudget { get; set; }
    [Parameter] public long MovieRevenue { get; set; }
    [Parameter] public int MovieRuntime { get; set; }
    [Parameter] public string MovieOverview { get; set; } = "";
    [Parameter] public double MoviePopularity { get; set; }
    [Parameter] public List<MovieDetail> SimilarMovies { get; set; } = new();
    [Parameter] public EventCallback<MovieDetail> OnMovieSelected { get; set; }

    private async Task NavigateToSimilarMovie(int movieId)
    {
        await Task.Run(() => NavigationManager.NavigateTo($"{AppRoutes.MovieDetailView}/{movieId}", forceLoad: true));
    }

}
