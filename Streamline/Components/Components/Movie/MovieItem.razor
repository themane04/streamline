@code {
    [Parameter] public List<Movie>? Movies { get; set; }
    [Parameter] public MovieDetail? SingleMovie { get; set; }
    [Parameter] public EventCallback<int> OnMovieSelected { get; set; }
    [Parameter] public string? PosterHeight { get; set; } = "";
    [Parameter] public string? PosterWidth { get; set; } = "";
    [Parameter] public string? PosterMt { get; set; } = "";
    [Parameter] public string? PosterMl { get; set; } = "";
    [Parameter] public string? RatingVoteMt { get; set; } = "";
    [Parameter] public string? RatingVoteMl { get; set; } = "";
    [Parameter] public bool ShowRating { get; set; } = true;

    private bool IsMovieNull => SingleMovie == null;

    private IEnumerable<Movie> GetMoviesToRender()
    {
        if (SingleMovie != null)
        {
            return new List<Movie>
            {
                MapMovieDetailToMovie(SingleMovie)
            };
        }

        return Movies ?? Enumerable.Empty<Movie>();
    }

    private Movie MapMovieDetailToMovie(MovieDetail detail)
    {
        return new Movie
        {
            Id = detail.Id,
            Title = detail.Title,
            Overview = detail.Overview,
            PosterPath = detail.PosterPath ?? string.Empty,
            VoteAverage = detail.VoteAverage,
            VoteCount = detail.VoteCount,
            BackdropPath = detail.BackdropPath,
            ReleaseDate = detail.ReleaseDate,
            OriginalLanguage = detail.OriginalLanguage,
            Popularity = detail.Popularity
        };
    }

}

@foreach (var movie in GetMoviesToRender())
{
    <div class="movie-item-container scale-on-interaction" @onclick="() => OnMovieSelected.InvokeAsync(movie.Id)">
        <img
            src="@movie.FullPosterPath"
            alt="@movie.Title"
            class="movie-item-movie-poster"
            style="
                height: @PosterHeight;
            width: @PosterWidth;
            margin-top: @PosterMt;
            margin-left: @PosterMl;"
        />
        @if (IsMovieNull || ShowRating)
        {
            <MovieRating
                VoteAverage="@movie.VoteAverage.ToString("0.0")"
                VoteMt="@RatingVoteMt"
                VoteMl="@RatingVoteMl"
            />
        }
    </div>
}