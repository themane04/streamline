<MudButton OnClick="NavigateBack"
           Class="scale-on-interaction mud-back-arrow-button-component-button"
           Style="@ButtonStyle">
    <img src="images/assets/navigation/back-arrow.png" alt="Back" class="back-arrow-button-component-button-image"/>
</MudButton>

@code {
    [Parameter] public string BackUrl { get; set; } = string.Empty;
    [Parameter] public string Position { get; set; } = "absolute";
    [Parameter] public string Top { get; set; } = "20px";
    [Parameter] public string Left { get; set; } = "20px";

    private string ButtonStyle => $@"
        position: {Position};
        top: {Top};
        left: {Left};
    ";

    private void NavigateBack()
    {
        NavigationManager.NavigateTo(BackUrl);
    }

}