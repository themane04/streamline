@code {
    [Parameter] public string BackUrl { get; set; } = AppRoutes.HomeUrl;

    private void NavigateBack()
    {
        NavigationManager.NavigateTo(BackUrl, forceLoad: true);
    }

}

<MudButton OnClick="NavigateBack"
           Class="scale-on-interaction"
           Style="
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 1;
    background: rgba(255, 255, 255, 0.31);
    border: none;
    border-radius: 50%;
    padding: 10px;
    width: 42px;
    height: 42px;
    box-shadow: var(--action-box-shadow);
    align-items: center;
    justify-content: center;
    display: flex;
"
>
    <img src="images/assets/navigation/back-arrow.png" alt="Back" style="height: 20px;width: 20px"/>
</MudButton>