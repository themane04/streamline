<nav class="navigation-bottom-nav">
    <a @onclick="() => NavigateTo(AppRoutes.HomeUrl)" class="navigation-nav-item">
        <MudIcon Icon="@GetIcon("home")" Class="mud-navigation-component-icon"/>
    </a>
    <a @onclick="() => NavigateTo(AppRoutes.WatchlistUrl)" class="navigation-nav-item">
        <MudIcon Icon="@GetIcon("watchlist")" Class="mud-navigation-component-icon"/>
    </a>
    <a @onclick="() => NavigateTo(AppRoutes.FavoritesUrl)" class="navigation-nav-item">
        <MudIcon Icon="@GetIcon("favorites")" Class="mud-navigation-component-icon"/>
    </a>
    <a @onclick="() => NavigateTo(AppRoutes.ProfileUrl)" class="navigation-nav-item">
        @if (!string.IsNullOrEmpty(User?.ProfileImage))
        {
            <img src="@User.ProfileImage" alt="Profile" class="mud-navigation-component-icon navigation-profile-image"/>
        }
        else
        {
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Class="mud-navigation-component-icon"/>
        }
    </a>
</nav>

@code {
    private string CurrentUrl { get; set; } = string.Empty;
    private AuthenticatedUser? User => AuthService.User;

    public void Dispose()
    {
        AuthService.OnChange -= StateHasChanged;
    }

    protected override void OnInitialized()
    {
        CurrentUrl = NavigationManager?.Uri.ToLower() ?? string.Empty;

        if (NavigationManager == null)
        {
            return;
        }

        AuthService.OnChange += StateHasChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CurrentUrl = e.Location.ToLower();
        StateHasChanged();
    }

    private string GetIcon(string page)
    {
        if (page == "home")
        {
            return CurrentUrl.Contains(AppRoutes.HomeUrl) || CurrentUrl.Contains(AppRoutes.MovieDetailView)
                ? Icons.Material.Filled.Home
                : Icons.Material.Outlined.Home;
        }

        if (page == "watchlist")
        {
            return CurrentUrl.Contains(AppRoutes.WatchlistUrl)
                ? Icons.Material.Filled.Bookmark
                : Icons.Material.Outlined.BookmarkBorder;
        }

        if (page == "favorites")
        {
            return CurrentUrl.Contains(AppRoutes.FavoritesUrl)
                ? Icons.Material.Filled.Favorite
                : Icons.Material.Outlined.FavoriteBorder;
        }

        return Icons.Material.Outlined.AccountCircle;
    }

    private void NavigateTo(string url)
    {
        NavigationManager.NavigateTo(url);
    }

}
