<nav class="navigation-bottom-nav">
    <a @onclick="() => NavigateTo(AppRoutes.HomeUrl)" class="navigation-nav-item scale-on-interaction">
        <img src="@GetIcon("home")" alt="Home" class="navigation-nav-icon"/>
    </a>
    <a @onclick="() => NavigateTo(AppRoutes.WatchlistUrl)" class="navigation-nav-item scale-on-interaction">
        <img src="@GetIcon("watchlist")" alt="Watchlist" class="navigation-nav-icon"/>
    </a>
    <a @onclick="() => NavigateTo(AppRoutes.FavoritesUrl)" class="navigation-nav-item scale-on-interaction">
        <img src="@GetIcon("favorites")" alt="Favorites" class="navigation-nav-icon"/>
    </a>
    <a @onclick="() => NavigateTo(AppRoutes.ProfileUrl)" class="navigation-nav-item scale-on-interaction">
        <img src="@AuthService?.User?.ProfileImage" alt="Profile" class="navigation-nav-icon navigation-profile-image"/>
    </a>
</nav>

@code {
    [Inject] private AuthService AuthService { get; set; } = default!;
    private string CurrentUrl { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        CurrentUrl = NavigationManager?.Uri.ToLower() ?? string.Empty;

        if (NavigationManager == null)
        {
            return;
        }

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CurrentUrl = e.Location.ToLower();
        StateHasChanged();
    }

    private string GetIcon(string page)
    {
        if (page == "home" && (CurrentUrl.Contains(AppRoutes.HomeUrl) || CurrentUrl.Contains(AppRoutes.MovieDetailView)))
        {
            return $"images/assets/navigation/active/{page}_active.png";
        }

        return CurrentUrl.Contains(page)
            ? $"images/assets/navigation/active/{page}_active.png"
            : $"images/assets/navigation/{page}.png";
    }

    private void NavigateTo(string url)
    {
        NavigationManager.NavigateTo(url);
    }

}
