<nav class="bottom-nav">
    <a href="@AppRoutes.HomeUrl" class="nav-item scale-on-interaction">
        <img src="@GetIcon("home")" alt="Home" class="nav-icon"/>
    </a>
    <a href="@AppRoutes.BookmarkUrl" class="nav-item scale-on-interaction">
        <img src="@GetIcon("bookmark")" alt="Bookmark" class="nav-icon"/>
    </a>
    <a href="@AppRoutes.FavoritesUrl" class="nav-item scale-on-interaction">
        <img src="@GetIcon("favorites")" alt="Favorites" class="nav-icon"/>
    </a>
    <a href="@AppRoutes.ProfileUrl" class="nav-item scale-on-interaction">
        <img src="@GetIcon("profile")" alt="Profile" class="nav-icon"/>
    </a>
</nav>

@code {
    [Inject] private NavigationManager? NavigationManager { get; set; }
    private string CurrentUrl { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        CurrentUrl = NavigationManager?.Uri.ToLower() ?? string.Empty;

        if (NavigationManager == null)
        {
            return;
        }

        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CurrentUrl = e.Location.ToLower();
        StateHasChanged();
    }

    private string GetIcon(string page)
    {
        return CurrentUrl.Contains(page)
            ? $"images/assets/navigation/active/{page}_active.png"
            : $"images/assets/navigation/{page}.png";
    }

}