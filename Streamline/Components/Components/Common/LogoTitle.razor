<div class="logo-title-inner-container">
    @if (ShowBackArrow)
    {
        <BackArrowButton BackUrl="@BackUrl" Position="relative" Top="0" Left="0" />
    }
    <img src="images/logo/streamline_transparent.png"
         alt="Streamline Logo"
         class="logo-title-image"
         style="width: @LogoWidth; height: @LogoHeight;"
    />
    <p class="logo-title-streamline-title">@Title</p>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Streamline";
    [Parameter] public string LogoWidth { get; set; } = "100px";
    [Parameter] public string LogoHeight { get; set; } = "100px";
    [Parameter] public string BackUrl { get; set; } = string.Empty;
    [Parameter] public bool ShowBackArrow { get; set; }
}
