@if (IsVisible)
{
    <div class="modal-overlay @String.ModalClass(IsVisible)" @onclick="CloseModalOnOverlayClick">
        <div class="modal-content" style="@String.ModalStyle(Width,Height)" @onclick:stopPropagation>
            <button class="close-button" @onclick="CloseModal">
                <MudIcon Icon="@Icons.Material.Filled.Close"
                         Class="mud-toast-component-message-icon scale-on-interaction"
                         Style="fill: var(--text-color) !important;"/>
            </button>
            <h4>@Title</h4>
            <p>@Description</p>
            @ChildContent
            @if (!string.IsNullOrEmpty(ButtonText))
            {
                <MudButton Class="mud-modal-component-action-button scale-on-interaction" OnClick="OnButtonClick">
                    @if (ProfileImageIcon)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.UploadFile"
                                 Class="mud-modal-component-button-icon-container"/>
                    }
                    @if (EditProfileInfoIcon)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mud-modal-component-button-icon-container"/>
                    }
                    @if (PasswordResetIcon)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mud-modal-component-button-icon-container"/>
                    }
                    @if (SignOutIcon)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.ExitToApp"
                                 Class="mud-modal-component-button-icon-container"/>
                    }
                    @if (DeleteAccountIcon)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Delete"
                                 Class="mud-modal-component-button-icon-container"/>
                    }
                    <span>@ButtonText</span>
                </MudButton>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string ButtonText { get; set; } = string.Empty;
    [Parameter] public EventCallback OnButtonClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<bool> OnClose { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Width { get; set; } = "500px";
    [Parameter] public string Height { get; set; } = "auto";
    [Parameter] public bool CloseOnOverlayClick { get; set; } = true;
    [Parameter] public bool ProfileImageIcon { get; set; }
    [Parameter] public bool EditProfileInfoIcon { get; set; }
    [Parameter] public bool PasswordResetIcon { get; set; }
    [Parameter] public bool SignOutIcon { get; set; }
    [Parameter] public bool DeleteAccountIcon { get; set; }

    private async Task CloseModal()
    {
        await OnClose.InvokeAsync(false);
    }

    private async Task CloseModalOnOverlayClick()
    {
        if (CloseOnOverlayClick)
        {
            await CloseModal();
        }
    }

}