<div class="toast-container">
    @for (int i = 0; i < Toasts.Count; i++)
    {
        var toast = Toasts[i];
        <div class="toast @toast.Status @(toast.IsVisible ? "" : "toast-hide") @(toast.NeedsSlideUp ? "slide-up" : "")">
            <div class="toast-content">
                <MudIcon Icon="@GetIcon(toast.Status)" Class="mud-toast-component-message-icon" />
                <span>@toast.Message!</span>
            </div>
        </div>
    }
</div>

@code {
    private List<ToastMessage> Toasts { get; set; } = new();

    protected override void OnInitialized()
    {
        ToastService.OnShowToast += Show;
    }

    private void Show(string message, ToastStatus status)
    {
        var toast = new ToastMessage
        {
            Message = message,
            Status = status switch
            {
                ToastStatus.Success => "toast-success",
                ToastStatus.Error => "toast-error",
                ToastStatus.Warning => "toast-warning",
                ToastStatus.Info => "toast-info",
                _ => "toast-success"
            },
            IsVisible = true
        };

        Toasts.Add(toast);
        if (Toasts.Count > 4)
        {
            Toasts.RemoveAt(0);
        }
        StateHasChanged();
        StartTimer(toast);
    }

    private string GetIcon(string status)
    {
        return status switch
        {
            "toast-success" => Icons.Material.Filled.CheckCircle,
            "toast-error" => Icons.Material.Filled.Error,
            "toast-warning" => Icons.Material.Filled.Warning,
            "toast-info" => Icons.Material.Filled.Info,
            _ => Icons.Material.Filled.Info
        };
    }

    private void StartTimer(ToastMessage toast)
    {
        var timer = new System.Timers.Timer(4500);
        timer.Elapsed += async (sender, args) =>
        {
            toast.IsVisible = false;
            await InvokeAsync(StateHasChanged);

            await Task.Delay(500);

            await InvokeAsync(() =>
            {
                Toasts.Remove(toast);
                foreach (var remainingToast in Toasts)
                {
                    remainingToast.NeedsSlideUp = true;
                }
                StateHasChanged();
            });

            timer.Dispose();
        };
        timer.Start();
    }
}