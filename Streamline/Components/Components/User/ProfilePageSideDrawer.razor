<div class="profile-page-side-drawer-component-right" style="@String.DrawerStyle(IsDrawerOpen)">
    <div class="profile-page-side-drawer-component-button-container">
        <MudIcon Icon="@Icons.Material.Filled.Close" Class="mud-profile-page-button-icon scale-on-interaction"
                 @onclick="CloseDrawer"/>
    </div>
    <div class="profile-page-side-drawer-component-content">
        <div class="profile-page-side-drawer-component-content-buttons">
            <MudButton Class="mud-profile-page-button-link scale-on-interaction mt-3 fs-4"
                       OnClick="OpenEditProfileInfoModal">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mud-profile-page-button-icon"/>
                Edit Profile
            </MudButton>
            <MudButton Class="mud-profile-page-button-link scale-on-interaction mt-3 fs-4"
                       OnClick="OpenPasswordModal">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mud-profile-page-button-icon"/>
                Change Password
            </MudButton>
            <MudButton Class="mud-profile-page-button-link scale-on-interaction mt-3 fs-4"
                       OnClick="OpenNotificationsModal">
                <MudIcon Icon="@Icons.Material.Filled.Notifications" Class="mud-profile-page-button-icon"/>
                Notifications
            </MudButton>
            <MudButton Class="mud-profile-page-button-link scale-on-interaction mt-3 fs-4"
                       OnClick="OpenPreferencesModal">
                <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mud-profile-page-button-icon"/>
                Preferences
            </MudButton>
            <MudButton Class="mud-profile-page-button-link scale-on-interaction mt-3 fs-4"
                       OnClick="() => NavigationManager.NavigateTo(AppRoutes.InfoUrl)">
                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mud-profile-page-button-icon"/>
                About
            </MudButton>
            <MudButton Class="mud-profile-page-button-link scale-on-interaction mt-3 fs-4"
                       OnClick="() => NavigationManager.NavigateTo(AppRoutes.FaqUrl)">
                <MudIcon Icon="@Icons.Material.Filled.Help" Class="mud-profile-page-button-icon"/>
                FAQ
            </MudButton>
        </div>
        <div class="mt-auto">
            <MudButton Class="mud-profile-page-button-link scale-on-interaction mt-3 fs-4"
                       OnClick="OpenSignOutModal">
                <MudIcon Icon="@Icons.Material.Filled.ExitToApp" Class="mud-profile-page-button-icon"/>
                Sign Out
            </MudButton>
            <MudButton Class="mud-profile-page-button-link scale-on-interaction mt-3 fs-4 text-danger"
                       OnClick="OpenAccountDeletionModal">
                <MudIcon Icon="@Icons.Material.Filled.Delete"
                         Class="mud-profile-page-button-icon mud-profile-page-delete-icon"/>
                Delete Account
            </MudButton>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsDrawerOpen { get; set; }
    [Parameter] public EventCallback CloseDrawer { get; set; }
    [Parameter] public EventCallback OpenEditProfileInfoModal { get; set; }
    [Parameter] public EventCallback OpenPasswordModal { get; set; }
    [Parameter] public EventCallback OpenSignOutModal { get; set; }
    [Parameter] public EventCallback OpenAccountDeletionModal { get; set; }
    [Parameter] public EventCallback OpenNotificationsModal { get; set; }
    [Parameter] public EventCallback OpenPreferencesModal { get; set; }
}