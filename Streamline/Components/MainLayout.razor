<div class="main-layout-page-container">
    <div class="main-layout-inner-container" style="@(IsMovieDetailView ? "margin-top: 0" : "8vw")">
        <Toast/>
        @Body
    </div>
</div>

@if (!ShouldExcludeNav())
{
    <Navigation/>
}

@code {
    [Parameter] public RenderFragment? Body { get; set; }
    private bool IsMovieDetailView => NavigationManager?.Uri.Contains(AppRoutes.MovieDetailView) ?? false;

    private bool ShouldExcludeNav()
    {
        var currentUrl = NavigationManager?.Uri.ToLower();

        if (string.IsNullOrEmpty(currentUrl))
        {
            return false;
        }

        var baseUri = NavigationManager?.BaseUri.TrimEnd('/').ToLower() ?? "";
        var relativeUrl = currentUrl.Replace(baseUri, "").TrimStart('/');

        return AppRoutes.ExcludedRoutes.Contains("/" + relativeUrl);
    }

}